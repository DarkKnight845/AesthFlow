# --- LLM Provider ---
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_ANTHROPIC_KEY

# --- Web Search ---
TAVILY_API_KEY=tvly-REPLACE_WITH_YOUR_TAVILY_KEY

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5434/orchestrator
DATABASE_URL_SYNC=postgresql+psycopg2://orchestrator:orchestrator@localhost:5434/orchestrator

# --- Redis (event bus) ---
REDIS_URL=redis://localhost:6379/0

# --- Sandbox limits ---
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_DOCKER_IMAGE=python:3.11-slim

# --- Cost guardrails ---
MAX_TOKENS_PER_RUN=50000

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO